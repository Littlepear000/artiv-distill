DATABASE_URL=postgresql+psycopg2://pdf_app:pdf_app_password@localhost:5432/pdf_workflow
AUTH_DATABASE_URL=postgresql+psycopg2://pdf_app_auth:pdf_app_auth_password@localhost:5432/pdf_workflow
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:4566
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_REGION=us-east-1
S3_BUCKET=pdf-workflow

SANDBOX_IMAGE=pdf-workflow-sandbox:latest
SANDBOX_INTERNAL_TOKEN=dev-sandbox-token-change-me
# docker-compose 为这个 Docker 网络起的实际名字（见 docker-compose.yml 的 networks.sandbox_net.name）
SANDBOX_NETWORK=pdf_workflow_sandbox_net
LLM_PROXY_URL=http://backend:8000/internal/llm/complete
# 仅 worker 在 docker-compose 里运行时需要：worker 通过 docker.sock 调用的是宿主机的
# Docker daemon（sibling containers 模式），所以传给沙箱容器的挂载路径必须是宿主机的
# 真实路径。SANDBOX_TMP_DIR 是 worker 容器自己看到的挂载点，HOST_SANDBOX_TMP_DIR 是
# 宿主机上同一个目录的真实绝对路径（docker-compose.yml 里已经用 ${PWD} 自动算好了，
# 本机不用 Docker 直接跑 worker 时这两项都不需要）
SANDBOX_TMP_DIR=/sandbox-tmp
HOST_SANDBOX_TMP_DIR=

# 不填则节点 Prompt 的 AI 调用会返回 503，其余功能（PDF 上传、Code 节点执行）不受影响
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
