# Production environment for docker-compose.prod.yml.
# Copy to /srv/artiv-distill/.env on the server (mode 640, owner lixueqi1213:artiv-distill).
# Generate every secret with:  openssl rand -hex 24

# --- database / auth (postgres runs inside the compose stack, never published) ---
POSTGRES_PASSWORD=
PDF_APP_PASSWORD=
PDF_APP_AUTH_PASSWORD=
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- sandbox ---
SANDBOX_INTERNAL_TOKEN=
# the artiv-distill rootless Docker daemon (uid 996) and a directory that daemon can read and write
DOCKER_SOCK=/run/user/996/docker.sock
SANDBOX_TMP_HOST_DIR=/srv/artiv-distill/data/sandbox-tmp

# --- object storage: Aliyun OSS (S3 API) ---
# internal endpoint = free, fast traffic inside the same Aliyun region; the public one is for browser links
S3_ENDPOINT_URL=https://oss-cn-beijing-internal.aliyuncs.com
S3_PUBLIC_ENDPOINT_URL=https://oss-cn-beijing.aliyuncs.com
S3_REGION=cn-beijing
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ADDRESSING_STYLE=virtual

# --- AI ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Uncomment only if api.anthropic.com is not reachable from the server and you have a relay:
# ANTHROPIC_BASE_URL=https://your-relay.example.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- web ---
WEB_BIND=127.0.0.1:8012
CORS_ALLOW_ORIGINS=https://artiv.unicell.org.cn

# --- build-time mirrors (Aliyun ECS internal mirrors; drop both lines outside Aliyun) ---
PIP_INDEX_URL=https://mirrors.cloud.aliyuncs.com/pypi/simple/
NPM_REGISTRY=https://registry.npmmirror.com/
